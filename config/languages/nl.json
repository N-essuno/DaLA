{
  "schema_version": 1,
  "language": "nl",
  "name": "DaLA Dutch — DynaWord",
  "mode": "pairs",
  "parser": "nl_core_news_md",
  "parser_version": "3.8.0",
  "parser_requirements": {
    "components": [
      "parser",
      "morphologizer",
      "lemmatizer",
      "ner"
    ],
    "vectors": true
  },
  "sources": {
    "adapter": "dynaword"
  },
  "sources_config": "../dutch_sources.json",
  "rulebook": "../dutch_rules.json",
  "exclusions": "../dutch_source_exclusions.json",
  "adapter": "dala.language_packs.dutch:DutchPack",
  "selection": {
    "strategy": "rare_first",
    "max_errors": 2,
    "priority": [
      "verb_dt",
      "subject_verb_agreement",
      "article_gender",
      "demonstrative_agreement",
      "article_number",
      "spelling"
    ]
  },
  "checker": {
    "mode": "local",
    "dialects": [
      "nl"
    ],
    "workers": 32,
    "lexical_carrier": "Het woord is ",
    "hard_rule_ids": [
      "HET_FIETS",
      "HET_RESULTATEN",
      "DEF_ART_PLUS_NOUN",
      "IK_LOOPT",
      "JIJ_LOOP",
      "HIJ_VIND",
      "WIJ_LOOP",
      "EEN_LELIJKE_MEISJE",
      "DE_IPV_HET",
      "HET_ZNW_DE_ZNW_HET",
      "DEZE_WASMIDDEL",
      "NL_SIMPLE_REPLACE_IK_VINDT",
      "NL_SIMPLE_REPLACE_IK_VINDT_HET",
      "NL_SIMPLE_REPLACE_IK_IS",
      "NL_SIMPLE_REPLACE_HET_STAD",
      "NL_SIMPLE_REPLACE_HET_KOSTEN_VOOR",
      "NL_SIMPLE_REPLACE_HET_KOSTEN_VAN",
      "NL_SIMPLE_REPLACE_HET_RESULTATEN",
      "NL_SIMPLE_REPLACE_HET_RESULTATEN_VAN_HET"
    ],
    "server_threads": 16,
    "heap": "8g",
    "cache_commit_batch_size": 128
  },
  "prompts": {
    "acceptability": "Is deze Nederlandse zin grammaticaal correct en juist gespeld? Antwoord alleen met yes of no.",
    "correction": "Verbeter grammatica- en spelfouten in deze Nederlandse zin. Als de zin al correct is, geef hem ongewijzigd terug. Behoud de betekenis en opmaak. Geef alleen de zin."
  },
  "description": "Pinned Dutch DynaWord government web prose, selected through source annotations and Dutch sentence/checker filters. Machine annotations are not grammatical gold. Original article URL/author are unavailable; preserve pinned dataset coordinates.",
  "grammar": {
    "noun_articles": {
      "deur": "de",
      "fles": "de",
      "gemeenschap": "de",
      "getuige": "de",
      "informatie": "de",
      "koningin": "de",
      "koe": "de",
      "moeder": "de",
      "organisatie": "de",
      "prins": "de",
      "stoel": "de",
      "tafel": "de",
      "regering": "de",
      "vader": "de",
      "verpleegkundige": "de",
      "vrouw": "de",
      "appel": "de",
      "film": "de",
      "strijd": "de",
      "trap": "de",
      "soep": "de",
      "stad": "de",
      "taal": "de",
      "vaas": "de",
      "vlag": "de",
      "gebergte": "het",
      "geluk": "het",
      "feminisme": "het",
      "kind": "het",
      "meisje": "het",
      "paard": "het",
      "systeem": "het",
      "tafeltje": "het",
      "huis": "het",
      "scherm": "het"
    },
    "pronoun_verbs": {
      "ik": {
        "ben": "is",
        "heb": "heeft",
        "kan": "kunnen",
        "moet": "moeten",
        "ga": "gaat",
        "kom": "komt",
        "werk": "werkt",
        "word": "wordt",
        "vind": "vindt"
      },
      "hij": {
        "is": "zijn",
        "heeft": "hebben",
        "kan": "kunnen",
        "moet": "moeten",
        "gaat": "gaan",
        "komt": "komen",
        "werkt": "werken",
        "wordt": "word",
        "vindt": "vind"
      },
      "wij": {
        "zijn": "is",
        "hebben": "heeft",
        "kunnen": "kan",
        "moeten": "moet",
        "gaan": "gaat",
        "komen": "komt",
        "werken": "werkt",
        "worden": "wordt"
      },
      "we": {
        "zijn": "is",
        "hebben": "heeft",
        "kunnen": "kan",
        "moeten": "moet",
        "gaan": "gaat",
        "komen": "komt",
        "werken": "werkt",
        "worden": "wordt"
      }
    },
    "require_plural_lemma_change": true,
    "plural_determiners_require_plural_subject": true
  },
  "curation": {
    "boilerplate_regex": "https?://|www\\.|cookie|javascript|copyright|privacyverklaring|nieuwsbrief|lees meer|meer informatie|download|inhoudsopgave|contactformulier|accessibility|toegankelijkheidsverklaring",
    "max_paragraphs_per_document": 12,
    "punctuation_without_space_regex": "[,;:!?][^\\W\\d_]"
  },
  "dependencies": [
    "requests",
    "pyarrow",
    "huggingface-hub"
  ],
  "lexicon": "../../la_output/resources/nl/wordlist.txt",
  "lexicon_sha256": "12e5fb5e3c73840b583b30016926d1f63a75e9bf1652a3a6634b2ba7c49ad7be",
  "lexicon_source": "https://raw.githubusercontent.com/OpenTaal/opentaal-wordlist/b250510dda431785f962019167d1415198ff3905"
}
